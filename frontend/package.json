{
  "name": "frontend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "prebuild": "chmod +x ./node_modules/@esbuild/linux-x64/bin/esbuild || true",
    "build": "node ./node_modules/vite/bin/vite.js build",
    "preview": "node ./node_modules/vite/bin/vite.js preview",
    "postinstall": "mkdir -p ./node_modules/.bin && cp ./node_modules/vite/bin/vite.js ./node_modules/.bin/vite || true && chmod +x ./node_modules/.bin/vite || true"
  },
  "dependencies": {
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-router-dom": "^6.30.4"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.0.0",
    "autoprefixer": "^10.5.0",
    "postcss": "^8.5.15",
    "tailwindcss": "^3.4.19",
    "vite": "^4.0.0"
  }
}
